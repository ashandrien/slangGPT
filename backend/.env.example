# Copy this file to `.env` and fill in the values. Do NOT commit your `.env` file.
# Example values (do not use real keys here)
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: allowed CORS origins for dev
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: path to a JSON file containing the slang mapping used by the
# conversion routines. If relative, the path is resolved relative to the
# backend/ directory. Default: data/slang.json
SLANG_FILE=

# Optional: Honeycomb API key and dataset (do NOT commit your key). If set,
# the backend will attempt to initialize Honeycomb tracing via beeline.
# HONEYCOMB_API_KEY=key-REPLACE_ME
HONEYCOMB_API_KEY=
# Optional: dataset name to send events to in Honeycomb
HONEYCOMB_DATASET=slanggpt-backend
